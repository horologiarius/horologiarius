---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = await getCollection('blog');

const recentPosts = allPosts
	.filter((post) => post.data.status && post.data.status !== 'NULL')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main h1 {
				color: var(--color-text-heading);
			}
			main p {
				color: var(--color-text-primary);
			}
			main blockquote {
				color: var(--color-text-primary);
				border-left-color: var(--color-accent);
			}
			main a {
				color: var(--color-accent);
			}
			main a:hover {
				color: var(--color-accent-hover);
			}
			main code {
				background-color: var(--color-surface);
				color: var(--color-text-primary);
			}
		</style>
	</head>
	<body style="background: url('https://cdn.pixabay.com/photo/2020/07/12/13/23/hourglass-5397243_1280.jpg') no-repeat center center fixed; background-size: cover; min-height: 100vh;">
		<Header />
		<main>
			<h1>Guidelines</h1>
            <blockquote>
			<p>
				Logic gets its name from the Greek word logos, which has two meanings, for logos means "word" and "reason". Whence logic is divided into a rational and a discursive science. Rational logic, which is called argumentative, comprises dialectic and rhetoric. Discursive logic is the genus to which grammar, dialectic, and rhetoric belong, and it thus comprises the argumentative.
            </p>
            <footer>
			    — <i>Hugh of Saint Victor</i>
            </footer>
            </blockquote>

            <blockquote>
			<p>
				But if we hold most constantly to that course which God commands us, and which we have undertaken to hold, we shall arrive by the Power and Wisdom of God at the supreme Cause, or the supreme Author, or the supreme Principle of all things, or by whatever other name so great a reality can be more rightly called.
            </p>
            <footer>
			    — <i>Saint Augustine of Hippo</i>
            </footer>
            </blockquote>

			<table class="recent-table">
				<caption>Recent Writings</caption>
				<thead>
					<tr>
						<th>Created</th>
						<th>Type</th>
						<th>Status</th>
						<th>Topics</th>
					</tr>
				</thead>
				<tbody>
					{recentPosts.map((post) => (
						<tr>
							<td>
								<a href={`/blog/${post.id}/`}>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</td>
							<td>{post.data.type ?? '—'}</td>
							<td>{post.data.status ?? '—'}</td>
							<td>{post.data.topics?.join(', ') ?? '—'}</td>
						</tr>
					))}
				</tbody>
			</table>
		</main>
		<Footer />
	</body>
</html>
