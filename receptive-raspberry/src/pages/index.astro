---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			main h1 {
				color: var(--color-text-heading);
				font-size: 1.4em;
				margin-bottom: 1.5em;
			}
			main p {
				color: var(--color-text-primary);
				font-size: 13px;
				line-height: 1.8;
				margin-bottom: 1em;
			}
			main blockquote {
				color: var(--color-text-primary);
				border-left: 3px solid var(--color-accent);
				padding: 0.5em 1em;
				margin: 1em 0;
				font-size: 12px;
				line-height: 1.7;
			}
			main blockquote footer {
				color: var(--color-text-muted);
				font-size: 11px;
				margin-top: 0.5em;
			}
			main a {
				color: var(--color-accent);
			}
			main a:hover {
				color: var(--color-accent-hover);
			}
			main code {
				background-color: var(--color-surface);
				color: var(--color-text-primary);
			}
			main table {
				border-collapse: collapse;
				margin: 1em 0;
				font-size: 12px;
				width: 100%;
			}
			main caption {
				color: var(--color-text-heading);
				font-size: 1.2em;
				margin-bottom: 0.5em;
				text-align: left;
			}
			main td, main th {
				padding: 0.4em 0.8em;
				border: 1px solid var(--color-text-muted);
				text-align: left;
			}
			main th {
				color: var(--color-text-heading);
				font-weight: 700;
			}
			main td {
				color: var(--color-text-primary);
			}
			main tr:hover td {
				background-color: var(--color-surface);
			}
			main hr.section-break {
				border: none;
				border-top: 1px solid var(--color-text-muted);
				margin: 3em 0;
				opacity: 0.4;
			}
			.wormhole-gif {
				display: block;
				margin: 2em auto;
				max-width: 300px;
				width: 100%;
				height: auto;
				border-radius: 8px;
			}
		</style>
	</head>
	<body style="background: url('https://cdn.pixabay.com/photo/2020/07/12/13/23/hourglass-5397243_1280.jpg') no-repeat center center fixed; background-size: cover; min-height: 100vh;">
		<Header />
		<main>
			<h1>Guidelines</h1>
			<blockquote>
				<p>
					Logic gets its name from the Greek word logos, which has two meanings, for logos means "word" and "reason". Whence logic is divided into a rational and a discursive science. Rational logic, which is called argumentative, comprises dialectic and rhetoric. Discursive logic is the genus to which grammar, dialectic, and rhetoric belong, and it thus comprises the argumentative.
				</p>
				<footer>
					— <i>Hugh of Saint Victor</i>
				</footer>
			</blockquote>
			<hr class="section-break" />
			<blockquote>
				<p>
					But if we hold most constantly to that course which God commands us, and which we have undertaken to hold, we shall arrive by the Power and Wisdom of God at the supreme Cause, or the supreme Author, or the supreme Principle of all things, or by whatever other name so great a reality can be more rightly called.
				</p>
				<footer>
					— <i>Saint Augustine of Hippo</i>
				</footer>
			</blockquote>
			<hr class="section-break" />
			<table class="recent-table">
				<caption>Last Essays</caption>
				<thead>
					<tr>
						<th>Created</th>
						<th>Type</th>
						<th>Status</th>
						<th>Topics</th>
					</tr>
				</thead>
				<tbody>
					{
						recentPosts.map((post) => (
							<tr>
								<td>
									<a href={`/blog/${post.id}/`}>
										<FormattedDate date={post.data.pubDate} />
									</a>
								</td>
								<td>{post.data.type ?? '—'}</td>
								<td>{post.data.status ?? '—'}</td>
								<td>{post.data.topics?.join(', ') ?? '—'}</td>
							</tr>
						))
					}
				</tbody>
			</table>
			<img class="wormhole-gif" src="https://media1.tenor.com/m/ypwgjG2VB6UAAAAC/wormhole-black-and-white.gif" alt="Parallaxed wormhole" />
		</main>
		<Footer />
	</body>
</html>
