<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: rgba(10, 10, 10, 0.92);
		color: var(--color-text-muted);
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: var(--color-text-muted);
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}
	.social-links a:hover {
		color: var(--color-accent-hover);
	}
</style>
